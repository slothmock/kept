# API
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>
TEST_DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<test_database>

PORT=3000
WEB_ORIGIN=http://localhost:5173

MONAD_RPC_URL=https://rpc.testnet.monad.xyz
MONAD_CHAIN_ID=10143
# Set true only with MONAD_CHAIN_ID=31337.
ENABLE_LOCAL_ANVIL=false
COMMITMENT_MANAGER_ADDRESS=<commitment-manager-address>
KEPT_SAVINGS_VAULT_ADDRESS=<kept-vault-address>
COMMITMENT_VERIFIER_PRIVATE_KEY=<0x-private-key>
STAGING_YIELD_STRATEGY_ADDRESS=<staging-yield-strategy-address>

PRIVY_APP_ID=<privy-app-id>
PRIVY_JWT_VERIFICATION_KEY=<privy-jwt-verification-key>
PRIVY_APP_SECRET=<privy-app-secret>

AURORA_INTENTS_BASE_URL=<aurora-intents-api-url>
AURORA_INTENTS_API_KEY=<aurora-intents-api-key>

HELIUS_RPC_URL=https://<helius-rpc-url>

MOONPAY_WIDGET_BASE_URL=https://<moonpay-widget-url>
MOONPAY_PUBLISHABLE_KEY=<moonpay-publishable-key>
MOONPAY_SECRET_KEY=<moonpay-secret-key>

# Web
VITE_KEPT_API_URL=http://localhost:3000
VITE_PRIVY_APP_ID=<privy-app-id>
VITE_MONAD_RPC_URL=https://rpc.testnet.monad.xyz
VITE_MONAD_CHAIN_ID=10143
VITE_KEPT_VAULT_ADDRESS=<kept-vault-address>
VITE_COMMITMENT_MANAGER_ADDRESS=<commitment-manager-address>
VITE_MONAD_USDC_ADDRESS=<staging-usdc-address>
VITE_MOONPAY_PUBLISHABLE_KEY=<moonpay-publishable-key>

# Set only for explicit local Anvil development with chain ID 31337.
VITE_ENABLE_LOCAL_ANVIL=false

# Monad testnet deployment (public/config values only; keep private keys in Foundry keystores)
TESTNET_DEPLOYER_ADDRESS=<deployer-public-address>
TESTNET_COMMITMENT_VERIFIER=<verifier-public-address>
TESTNET_STAGING_APY_BPS=500

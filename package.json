{
  "name": "kept",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": "22.22.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:local": "scripts\\dev.bat",
    "dev:stop": "scripts\\stop.bat",
    "dev:restart": "npm run dev:stop && npm run dev:local",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx apps/api/src/db/migrate.ts",
    "db:migrate:local": "node --env-file=.env.local --import tsx apps/api/src/db/migrate.ts",
    "api:start": "node --import tsx apps/api/src/server.ts",
    "api:dev": "node --env-file=.env.local --import tsx apps/api/src/server.ts",
    "test": "vitest run",
    "test:contracts": "forge test --root packages/contracts",
    "test:contracts:fork": "forge test --root packages/contracts --match-contract MonadAaveForkTest --network monad",
    "test:integration": "vitest run apps/api/test/persistence.integration.test.ts",
    "typecheck": "tsc -b",
    "staging-yield:run": "node --import tsx apps/api/src/staging-yield-cron.ts"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "22.20.1",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10",
    "jsdom": "^30.1.1",
    "tsx": "4.23.13",
    "typescript": "5.9.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0"
  },
  "packageManager": "npm@10.9.7"
}
